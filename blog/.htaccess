# The blog's own addresses. Only mod_rewrite, like the root .htaccess, so it is safe on Plesk.
#
# A folder with its own rewrite rules takes over from the root .htaccess for every address inside it,
# so the root's /blog rules no longer run. The blog's home is therefore /blog/ (with the slash):
# the first rule below sends /blog there, and the folder serves index.html. Rewriting /blog/ back to /blog
# here would loop.
# php -S ignores this file; see private/dev-router.php.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Lets the rule below see /blog itself (Apache otherwise skips a folder's rules for its no-slash address)
  RewriteOptions AllowNoSlash

  # /blog -> /blog/ here, not by Apache's own slash redirect, which answers 500 on mock (/assets and /css too)
  RewriteCond %{THE_REQUEST} \s/blog(\?\S*)?\s
  RewriteRule ^ /blog/ [R=301,L]

  # One address for the blog's home: /blog/index.html -> /blog/
  RewriteCond %{THE_REQUEST} \s/blog/index\.html(\?\S*)?\s
  RewriteRule ^index\.html$ /blog/ [R=301,L]

  # /blog/sitemap.xml lists every published article for search engines
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Old article links (/blog/post.html?slug=x) move to /blog/x for good
  RewriteCond %{THE_REQUEST} \s/blog/post\.html\?
  RewriteCond %{QUERY_STRING} (?:^|&)slug=([a-z0-9]+(?:-[a-z0-9]+)*)(?:&|$)
  RewriteRule ^post\.html$ /blog/%1? [R=301,L]

  # Articles: /blog/x is served by post.php (real files and folders such as api/ are left alone)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+)*)$ post.php?slug=$1 [L]
</IfModule>
