# Pepper Labs - SPA routing (safe version for Plesk)
# Only uses mod_rewrite, so it can't trigger a 500 from AllowOverride limits.
# php -S on a laptop ignores this file; dev-router.php does the same job there.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Generated by PHP so each copy of the site can say whether search engines are welcome
  RewriteRule ^robots\.txt$ blog/robots.php [L]
  RewriteRule ^sitemap\.xml$ blog/sitemap.php [L]

  # Canonical blog URL is /blog: send /blog/ and /blog/index.html there
  RewriteCond %{THE_REQUEST} \s/blog/(index\.html)?(\?\S*)?\s
  RewriteRule ^blog/(index\.html)?$ /blog [R=301,L]

  # Serve the blog index at /blog
  RewriteRule ^blog$ blog/index.php [L]

  # Old article links (/blog/post.html?slug=x) move to /blog/x for good
  RewriteCond %{THE_REQUEST} \s/blog/post\.html\?
  RewriteCond %{QUERY_STRING} (?:^|&)slug=([a-z0-9]+(?:-[a-z0-9]+)*)(?:&|$)
  RewriteRule ^blog/post\.html$ /blog/%1? [R=301,L]

  # Articles: /blog/x is served by blog/post.php (folders such as /blog/api are left alone)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/([a-z0-9]+(?:-[a-z0-9]+)*)$ blog/post.php?slug=$1 [L]

  # Real files and folders are served as-is
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/blog/

  # Everything else -> React app
  RewriteRule ^ index.html [L]
</IfModule>
