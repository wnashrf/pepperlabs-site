# Pepper Labs - SPA routing (safe version for Plesk)
# Only uses mod_rewrite, so it can't trigger a 500 from AllowOverride limits.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical blog URL is /blog: send /blog/ there
  RewriteCond %{THE_REQUEST} \s/blog/(\?\S*)?\s
  RewriteRule ^blog/$ /blog [R=301,L]

  # Serve the blog index at /blog
  RewriteRule ^blog$ blog/index.html [L]

  # Real files and folders are served as-is
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/blog/

  # Everything else -> React app
  RewriteRule ^ index.html [L]
</IfModule>

# Designs 9 and 10 (pages in /public_html/, assets here): always revalidate so visitors get the latest version.
<IfModule mod_headers.c>
  <FilesMatch "^(design-switcher\.js|design-9\.css|design-9-bloom\.js|design-9-webgl\.js|design-10\.css|design-10-bloom\.js|design-10-webgl\.js|hibiscus-flower\.bin)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# Gzip the vendored PlayCanvas engine and the baked hibiscus model.
<IfModule mod_deflate.c>
  <FilesMatch "^(playcanvas\.min\.js|hibiscus-flower\.bin)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>
